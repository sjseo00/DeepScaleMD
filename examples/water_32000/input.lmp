# LAMMPS input for Water 32,000 molecules (CHARMM style)
units           real
atom_style      full
boundary        p p p
read_data       coordinates.xyz
pair_style      lj/cut/coul/long 10.0
bond_style      harmonic
angle_style     harmonic
kspace_style    pppm 1.0e-4
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
thermo          100
thermo_style    custom step temp etotal press
