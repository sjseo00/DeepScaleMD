units           real
atom_style      atomic
boundary        p p p
read_data       coordinates.lmp
velocity        all create 300.0 12345
pair_style      lj/cut 12.0
pair_coeff      * * 0.238 3.4

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
thermo          100
thermo_style    custom step temp etotal ke pe press fmax
timestep        1.0
fix             1 all nve
dump            1 all xyz 100 *.xyz 

# 특정 atom ID 1 (LAMMPS는 1부터 시작)의 velocity 출력
#group           atom0 id 1
#dump            2 atom0 custom 1 velocity_atom0.txt id vx vy vz fx fy fz
#dump_modify     2 format line "%d %.6f %.6f %.6f %.6f %.6f %.6f"

run             1000



